<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.ExpenseEditorPage"
    x:DataType="vm:ExpenseEditorViewModel"
    Title="{Binding PageTitle}"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#151821}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="600">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />

            <Label
                Text="{Binding SavedMessage}"
                IsVisible="{Binding IsSaved}"
                TextColor="{AppThemeBinding Light=#18794E, Dark=#75D6A6}" />

            <Button
                Text="Add another expense"
                Clicked="OnAddAnotherClicked"
                IsVisible="{Binding ShowAddAnother}" />

            <Button
                Text="Reload categories"
                Clicked="OnReloadClicked"
                IsEnabled="{Binding CanReload}" />

            <VerticalStackLayout
                Spacing="12"
                IsEnabled="{Binding CanEdit}">

                <Label
                    Text="Category"
                    FontAttributes="Bold" />

                <Picker
                    Title="Choose a category"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name, x:DataType=core:Category}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <Label Text="New category (optional)" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <Entry
                        Placeholder="Category name"
                        Text="{Binding NewCategoryName, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Text="Create category"
                        Clicked="OnAddCategoryClicked" />
                </Grid>

                <Label
                    Text="Creating a category saves it immediately."
                    FontSize="12" />

                <Label
                    Text="Amount"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="12.50"
                    Keyboard="Numeric"
                    Text="{Binding AmountText, Mode=TwoWay}" />

                <Label
                    Text="Use a dot or comma for decimals, for example 12.50 or 12,50."
                    FontSize="12" />

                <Label
                    Text="Date"
                    FontAttributes="Bold" />

                <DatePicker
                    Date="{Binding SelectedDate, Mode=TwoWay}"
                    MinimumDate="{x:Null}"
                    MaximumDate="{Binding MaximumDate}"
                    IsEnabled="{Binding CanEditDate}"
                    Format="dd.MM.yyyy" />

                <Label
                    Text="This expense was generated by a recurring schedule. Its date is fixed; these changes apply only to this occurrence."
                    IsVisible="{Binding HasFixedDate}"
                    FontSize="12" />

                <Label
                    Text="Description (optional)"
                    FontAttributes="Bold" />

                <Editor
                    Text="{Binding Description, Mode=TwoWay}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90" />

                <Button
                    Text="{Binding SaveButtonText}"
                    Clicked="OnSaveClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>