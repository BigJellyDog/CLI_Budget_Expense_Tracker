<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
             xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
             x:Class="ExpenseTracker.App.Views.AddExpensePage"
             x:DataType="vm:AddExpenseViewModel"
             Title="Add expense"
             NavigationPage.HasBackButton="{Binding CanGoBack}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="16"
                             MaximumWidthRequest="600"
                             HorizontalOptions="Fill">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />
            
            <VerticalStackLayout IsVisible="{Binding IsSaved}" Spacing="8">
                   <Label Text="Expense saved."
                          FontAttributes="Bold"
                          TextColor="{AppThemeBinding Light=#16703C, Dark=#83D9A4}" />

                   <Button Text="Add another expense"
                           Clicked="OnAddAnotherClicked" />
            </VerticalStackLayout>

            <Button Text="Reload categories"
                    Clicked="OnReloadClicked"
                    IsEnabled="{Binding CanReload}" />

            <VerticalStackLayout Spacing="12"
                                 IsEnabled="{Binding CanEdit}">

                <Label Text="Category" FontAttributes="Bold" />

                <Picker Title="Select a category"
                        ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name, x:DataType=core:Category}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Entry Placeholder="New category name"
                           Text="{Binding NewCategoryName, Mode=TwoWay}" />

                    <Button Grid.Column="1"
                            Text="Create category"
                            Clicked="OnAddCategoryClicked" />
                </Grid>

                <Label Text="Creating a category saves it immediately."
                       FontSize="12" />

                <Label Text="Amount" FontAttributes="Bold" />

                <Entry Text="{Binding AmountText, Mode=TwoWay}"
                       Keyboard="Numeric"
                       Placeholder="12.50" />

                <Label Text="Use a comma or point for decimals, without thousands separators."
                       FontSize="12" />

                <Label Text="Date" FontAttributes="Bold" />

                <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}"
                            MaximumDate="{Binding MaximumDate}"
                            Format="dd.MM.yyyy" />

                <Label Text="Description (optional)"
                       FontAttributes="Bold" />

                <Editor Text="{Binding Description, Mode=TwoWay}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="90" />

                <Button Text="Save expense"
                        Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>