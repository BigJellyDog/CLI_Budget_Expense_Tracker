<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.BudgetsPage"
    x:DataType="vm:BudgetsViewModel"
    Shell.NavBarIsVisible="False"
    Title="Budgets"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,*">

        <Label
            Text="{loc:Tr Key='Budgets'}"
            FontSize="26"
            FontFamily="ManropeExtraBold"
            Padding="24,24,24,0" />

        <Grid
            Grid.Row="1"
            Padding="24,8,24,24"
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="16">

            <Grid
                ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="12">

                <Button
                    Text="{loc:Tr Key='Previous'}"
                    Clicked="OnPreviousClicked"
                    IsEnabled="{Binding CanPreviousMonth}" />

                <Label
                    Grid.Column="1"
                    Text="{Binding MonthTitle}"
                    FontSize="24"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />

                <Button
                    Grid.Column="2"
                    Text="{loc:Tr Key='Next'}"
                    Clicked="OnNextClicked"
                    IsEnabled="{Binding CanNextMonth}" />

                <Button
                    Grid.Column="3"
                    Text="{loc:Tr Key='Refresh'}"
                    Clicked="OnRefreshClicked"
                    IsEnabled="{Binding CanRefresh}" />
            </Grid>

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="8"
                IsEnabled="{Binding CanEdit}">

                <Label
                    Text="{loc:Tr Key='Set a limit for this month'}"
                    FontAttributes="Bold" />

                <Picker
                    Title="{loc:Tr Key='Choose a category'}"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name, x:DataType=core:Category}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <Entry
                        x:Name="LimitEntry"
                        Placeholder="{loc:Tr Key='Monthly limit, for example 300'}"
                        Keyboard="Numeric"
                        Text="{Binding LimitText, Mode=TwoWay}"
                        IsEnabled="{Binding CanSave}" />

                    <Button
                        Grid.Column="1"
                        Text="{loc:Tr Key='Save limit'}"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked"
                        IsEnabled="{Binding CanSave}" />
                </Grid>

                <Label
                    Text="{loc:Tr Key='A limit of 0 means no spending is budgeted for this category.'}"
                    FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding HasSuccess}"
                    TextColor="{DynamicResource Success}" />

                <Label
                    Text="{loc:Tr Key='Create a category on the Categories screen first.'}"
                    IsVisible="{Binding ShowNoCategories}" />
            </VerticalStackLayout>

            <CollectionView
                Grid.Row="3"
                ItemsSource="{Binding Items}"
                IsVisible="{Binding ShowResults}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="{loc:Tr Key='No budgets set for this month.'}"
                        Margin="24"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BudgetListItem">
                        <Border
                            Padding="16"
                            Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{DynamicResource Border}"
                            BackgroundColor="{DynamicResource Surface}">

                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                ColumnSpacing="16">

                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        Text="{Binding CategoryName}"
                                        FontAttributes="Bold" />

                                    <Label Text="{Binding Summary}" />

                                    <ProgressBar Progress="{Binding Progress}">
                                    <ProgressBar.Triggers>
                                        <DataTrigger
                                            TargetType="ProgressBar"
                                            Binding="{Binding IsOverBudget}"
                                            Value="True">
                                            <Setter Property="ProgressColor" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </ProgressBar.Triggers>
                                </ProgressBar>

                                    <Label
                                        Text="{Binding BalanceText}"
                                        TextColor="{DynamicResource Success}">

                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding IsOverBudget}"
                                                Value="True">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="{loc:Tr Key='Edit'}"
                                    Clicked="OnEditClicked"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Text="{loc:Tr Key='Remove limit'}"
                                    Clicked="OnRemoveLimitClicked"
                                    VerticalOptions="Center"
                                    Style="{StaticResource DangerButton}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>