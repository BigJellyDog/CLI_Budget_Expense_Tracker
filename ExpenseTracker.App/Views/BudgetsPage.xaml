<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.App.Controls"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    x:Class="ExpenseTracker.App.Views.BudgetsPage"
    x:DataType="vm:BudgetsViewModel"
    Shell.NavBarIsVisible="False"
    Title="Budgets"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <controls:CenteredContainer Padding="40,28,40,24">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">

            <!-- Title, month switch, refresh -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label
                        Text="{loc:Tr Key='Budgets'}"
                        FontSize="28"
                        FontFamily="ManropeExtraBold" />
                    <Label
                        Text="{loc:Tr Key='Monthly limits per category'}"
                        FontSize="13"
                        TextColor="{DynamicResource InkMuted}" />
                </VerticalStackLayout>

                <controls:MonthSwitch
                    Grid.Column="1"
                    Title="{Binding MonthTitle}"
                    Month="{Binding Month}"
                    CanGoPrevious="{Binding CanPreviousMonth}"
                    CanGoNext="{Binding CanNextMonth}"
                    PreviousClicked="OnPreviousClicked"
                    NextClicked="OnNextClicked"
                    MonthPicked="OnMonthPicked" />

                <controls:IconButton
                    Grid.Column="2"
                    Filled="True"
                    Icon="{x:Static controls:Icons.Refresh}"
                    Clicked="OnRefreshClicked"
                    IsEnabled="{Binding CanRefresh}" />
            </Grid>

            <!-- Totals and the limit form -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*,*,2*"
                ColumnSpacing="16"
                IsVisible="{Binding ShowResults}">

                <Border Padding="20,18">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="{loc:Tr Key='Total limit'}"
                            FontSize="12"
                            FontFamily="ManropeSemiBold"
                            TextColor="{DynamicResource InkMuted}" />
                        <Label
                            Text="{Binding TotalLimitText}"
                            FontSize="22"
                            FontFamily="ManropeExtraBold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="20,18">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="{loc:Tr Key='Spent (with limit)'}"
                            FontSize="12"
                            FontFamily="ManropeSemiBold"
                            TextColor="{DynamicResource InkMuted}" />
                        <Label
                            Text="{Binding SpentWithLimitText}"
                            FontSize="22"
                            FontFamily="ManropeExtraBold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Padding="20,18">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="{loc:Tr Key='Over the limit'}"
                            FontSize="12"
                            FontFamily="ManropeSemiBold"
                            TextColor="{DynamicResource InkMuted}" />
                        <Label
                            Text="{Binding OverText}"
                            FontSize="22"
                            FontFamily="ManropeExtraBold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding AnyOver}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3" Padding="20,16" IsEnabled="{Binding CanEdit}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="{Binding FormTitle}"
                            FontSize="15"
                            FontFamily="ManropeBold" />

                        <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="10">
                            <controls:DropDown
                                Title="{loc:Tr Key='Choose a category'}"
                                ItemsSource="{Binding Categories}"
                                DisplayMember="Name"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                            <Entry
                                x:Name="LimitEntry"
                                Grid.Column="1"
                                Placeholder="{loc:Tr Key='e.g. 300'}"
                                Keyboard="Numeric"
                                Text="{Binding LimitText, Mode=TwoWay}"
                                Completed="OnSaveClicked" />

                            <controls:PillButton
                                Grid.Column="2"
                                Text="{loc:Tr Key='Save'}"
                                IsPrimary="True"
                                Clicked="OnSaveClicked"
                                IsEnabled="{Binding CanSave}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Grid.Row="2" Spacing="6">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding HasSuccess}"
                    TextColor="{DynamicResource Success}" />

                <Label
                    Text="{loc:Tr Key='Create a category on the Categories screen first.'}"
                    IsVisible="{Binding ShowNoCategories}" />
            </VerticalStackLayout>

            <!-- One card per category -->
            <CollectionView
                x:Name="Cards"
                Grid.Row="3"
                ItemsSource="{Binding Items}"
                IsVisible="{Binding ShowResults}"
                SelectionMode="None"
                SizeChanged="OnCardsSizeChanged">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="3"
                        HorizontalItemSpacing="16"
                        VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label
                        Text="{loc:Tr Key='No budgets set for this month.'}"
                        Margin="24"
                        TextColor="{DynamicResource InkMuted}"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BudgetListItem">
                        <Border Padding="18,16" VerticalOptions="Start">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasNoLimit}" Value="True">
                                    <Setter Property="StrokeDashArray" Value="4,3" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid>
                                <!-- A category with a limit -->
                                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLimit}">
                                    <Grid ColumnDefinitions="38,*,Auto,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 11"
                                            BackgroundColor="{Binding Tint}">
                                            <controls:IconView
                                                Data="{x:Static controls:Icons.Wallet}"
                                                Color="{Binding Color}"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <FlexLayout
                                            Grid.Column="1"
                                            Wrap="Wrap"
                                            AlignItems="Center"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding CategoryName}"
                                                FontSize="15"
                                                FontFamily="ManropeBold"
                                                Margin="0,0,10,0" />
                                            <controls:Chip Text="{Binding StatusText}" ToneKey="{Binding StatusTone}" />
                                        </FlexLayout>

                                        <controls:IconButton
                                            Grid.Column="2"
                                            Icon="{x:Static controls:Icons.Edit}"
                                            Clicked="OnEditClicked" />

                                        <controls:IconButton
                                            Grid.Column="3"
                                            Icon="{x:Static controls:Icons.More}"
                                            Clicked="OnMoreClicked" />
                                    </Grid>

                                    <HorizontalStackLayout Spacing="8">
                                        <Label
                                            Text="{Binding AmountText}"
                                            FontSize="22"
                                            FontFamily="ManropeExtraBold" />
                                        <Label
                                            Text="{Binding LimitText}"
                                            TextColor="{DynamicResource InkMuted}"
                                            VerticalOptions="End"
                                            Margin="0,0,0,3" />
                                    </HorizontalStackLayout>

                                    <controls:MeterBar Value="{Binding Progress}" FillKey="{Binding StatusTone}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Text="{Binding FooterText}"
                                            FontSize="13"
                                            FontFamily="ManropeSemiBold"
                                            TextColor="{DynamicResource Success}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusTone}" Value="Danger">
                                                    <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusTone}" Value="Warning">
                                                    <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding PercentText}"
                                            FontSize="13"
                                            TextColor="{DynamicResource InkMuted}" />
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- A category without a limit -->
                                <Grid
                                    ColumnDefinitions="38,*,Auto"
                                    ColumnSpacing="12"
                                    IsVisible="{Binding HasNoLimit}">
                                    <Border
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        BackgroundColor="{Binding Tint}">
                                        <controls:IconView
                                            Data="{x:Static controls:Icons.Plus}"
                                            Color="{Binding Color}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding CategoryName}" FontFamily="ManropeBold" />
                                        <Label
                                            Text="{Binding NoLimitText}"
                                            FontSize="12"
                                            TextColor="{DynamicResource InkMuted}" />
                                    </VerticalStackLayout>

                                    <controls:PillButton
                                        Grid.Column="2"
                                        Text="{loc:Tr Key='Set limit'}"
                                        Clicked="OnEditClicked" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </controls:CenteredContainer>
</ContentPage>
