<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.BudgetsPage"
    x:DataType="vm:BudgetsViewModel"
    Title="Budgets"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#151821}">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="12">

            <Button
                Text="Previous"
                Clicked="OnPreviousClicked"
                IsEnabled="{Binding CanPreviousMonth}" />

            <Label
                Grid.Column="1"
                Text="{Binding MonthTitle}"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <Button
                Grid.Column="2"
                Text="Next"
                Clicked="OnNextClicked"
                IsEnabled="{Binding CanNextMonth}" />

            <Button
                Grid.Column="3"
                Text="Refresh"
                Clicked="OnRefreshClicked"
                IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8"
            IsEnabled="{Binding CanEdit}">

            <Label
                Text="Set a limit for this month"
                FontAttributes="Bold" />

            <Picker
                Title="Choose a category"
                ItemsSource="{Binding Categories}"
                ItemDisplayBinding="{Binding Name, x:DataType=core:Category}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">

                <Entry
                    x:Name="LimitEntry"
                    Placeholder="Monthly limit, for example 300"
                    Keyboard="Numeric"
                    Text="{Binding LimitText, Mode=TwoWay}"
                    IsEnabled="{Binding CanSave}" />

                <Button
                    Grid.Column="1"
                    Text="Save limit"
                    Clicked="OnSaveClicked"
                    IsEnabled="{Binding CanSave}" />
            </Grid>

            <Label
                Text="A limit of 0 means no spending is budgeted for this category."
                FontSize="12" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding HasSuccess}"
                TextColor="{AppThemeBinding Light=#18794E, Dark=#75D6A6}" />

            <Label
                Text="Create a category on the Categories screen first."
                IsVisible="{Binding ShowNoCategories}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding ShowResults}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No budgets set for this month."
                    Margin="24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BudgetListItem">
                    <Border
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light=#D8DDE8, Dark=#384054}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#202532}">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding CategoryName}"
                                    FontAttributes="Bold" />

                                <Label Text="{Binding Summary}" />

                                <ProgressBar Progress="{Binding Progress}" />

                                <Label
                                    Text="{Binding BalanceText}"
                                    TextColor="{AppThemeBinding Light=#18794E, Dark=#75D6A6}">

                                    <Label.Triggers>
                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding IsOverBudget}"
                                            Value="True">

                                            <Setter
                                                Property="TextColor"
                                                Value="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Edit"
                                Clicked="OnEditClicked"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>