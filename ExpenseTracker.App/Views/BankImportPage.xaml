<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.App.Controls"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.BankImportPage"
    x:DataType="vm:BankImportViewModel"
    Shell.NavBarIsVisible="False"
    Title="Bank CSV import"
    NavigationPage.HasBackButton="{Binding IsIdle}"
    BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,*">

        <Label
            Text="{loc:Tr Key='Import CSV'}"
            FontSize="26"
            FontFamily="ManropeExtraBold"
            Padding="24,24,24,0" />

        <Grid
            Grid.Row="1"
            Padding="24,8,24,24"
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="16">

            <VerticalStackLayout Spacing="8">
                <controls:DropDown
                    Title="{loc:Tr Key='File format'}"
                    ItemsSource="{Binding Formats}"
                    DisplayMember="Name"
                    SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}" />

                <HorizontalStackLayout Spacing="12">
                    <Button
                        Text="{loc:Tr Key='Choose CSV'}"
                        Clicked="OnChooseFileClicked"
                        IsEnabled="{Binding IsIdle}" />

                    <Button
                        Text="{loc:Tr Key='Auto-categorization rules'}"
                        Clicked="OnEditRulesClicked"
                        IsEnabled="{Binding IsIdle}" />
                </HorizontalStackLayout>

                <Label Text="{Binding FormatHint}" />

                <Label Text="{loc:Tr Key='Choose a file, tick the records to import and set a category for each one (the default category is used until you change it), then press Import selected. Records already imported are skipped.'}" />

                <Label
                    Text="{Binding FileName}"
                    FontAttributes="Bold"
                    LineBreakMode="MiddleTruncation" />

                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowMapping}">
                    <Label Text="{loc:Tr Key='How is this file written?'}" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <controls:DropDown
                            Title="{loc:Tr Key='Delimiter'}"
                            ItemsSource="{Binding Custom.DelimiterOptions}"
                            DisplayMember="Name"
                            SelectedItem="{Binding Custom.SelectedDelimiter, Mode=TwoWay}"
                            SelectedIndexChanged="OnDelimiterChanged" />

                        <controls:DropDown
                            Grid.Column="1"
                            Title="{loc:Tr Key='Number format'}"
                            ItemsSource="{Binding Custom.CultureOptions}"
                            DisplayMember="Label"
                            SelectedItem="{Binding Custom.SelectedCulture, Mode=TwoWay}" />

                        <Entry
                            Grid.Column="2"
                            Placeholder="{loc:Tr Key='Date format'}"
                            Text="{Binding Custom.DateFormat, Mode=TwoWay}" />
                    </Grid>

                    <Label
                        Text="{loc:Tr Key='Date format examples: yyyy-MM-dd, dd.MM.yyyy, MM/dd/yyyy (MM is the month, mm is minutes).'}"
                        FontSize="12" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <controls:DropDown
                            Title="{loc:Tr Key='Date column'}"
                            ItemsSource="{Binding Custom.Headers}"
                            SelectedItem="{Binding Custom.SelectedDateColumn, Mode=TwoWay}" />

                        <controls:DropDown
                            Grid.Column="1"
                            Title="{loc:Tr Key='Description column'}"
                            ItemsSource="{Binding Custom.Headers}"
                            SelectedItem="{Binding Custom.SelectedDescriptionColumn, Mode=TwoWay}" />

                        <controls:DropDown
                            Grid.Column="2"
                            Title="{loc:Tr Key='Amount column'}"
                            ItemsSource="{Binding Custom.Headers}"
                            SelectedItem="{Binding Custom.SelectedAmountColumn, Mode=TwoWay}" />

                        <controls:DropDown
                            Grid.Column="3"
                            Title="{loc:Tr Key='Currency column'}"
                            ItemsSource="{Binding Custom.CurrencyHeaders}"
                            SelectedItem="{Binding Custom.SelectedCurrencyColumn, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                        <controls:DropDown
                            Title="{loc:Tr Key='Sign of amounts'}"
                            ItemsSource="{Binding Custom.SignOptions}"
                            DisplayMember="Label"
                            SelectedItem="{Binding Custom.SelectedSign, Mode=TwoWay}" />

                        <Entry
                            Grid.Column="1"
                            Placeholder="{loc:Tr Key='Currency, e.g. EUR'}"
                            Text="{Binding Custom.DefaultCurrency, Mode=TwoWay}" />
                    </Grid>

                    <Button
                        Text="{loc:Tr Key='Show preview'}"
                        Clicked="OnShowPreviewClicked"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="8"
                IsVisible="{Binding ShowPreview}">

                <Label Text="{Binding Summary}" />

                <Label
                    Text="{Binding TotalText}"
                    FontSize="18"
                    FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='Create a category on the Categories screen first, then choose the file again.'}"
                    IsVisible="{Binding NeedsCategory}" />

                <controls:DropDown
                    Title="{loc:Tr Key='Default category for all records'}"
                    ItemsSource="{Binding Categories}"
                    DisplayMember="Name"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <Label
                    Text="{Binding SelectionText}"
                    FontAttributes="Bold" />

                <Button
                    Text="{loc:Tr Key='Import selected'}"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnImportClicked"
                    IsEnabled="{Binding CanImport}"
                    HorizontalOptions="Start" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding ResultMessage}"
                    IsVisible="{Binding HasResult}"
                    TextColor="{DynamicResource Success}" />
            </VerticalStackLayout>

            <CollectionView
                Grid.Row="3"
                ItemsSource="{Binding Items}"
                IsVisible="{Binding ShowPreview}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="{loc:Tr Key='The statement contains no transactions.'}"
                        Margin="24"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BankImportListItem">
                        <Border
                            Padding="16"
                            Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{DynamicResource Border}"
                            BackgroundColor="{DynamicResource Surface}">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="16"
                                RowSpacing="6">

                                <CheckBox
                                    Grid.RowSpan="2"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSelect}"
                                    VerticalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Kind}"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Amount}"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="End" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Description}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Date}" />

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Details}"
                                    FontSize="12" />

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Reason}"
                                    FontSize="12" />

                                <controls:DropDown
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Title="{loc:Tr Key='Category'}"
                                    ItemsSource="{Binding Categories}"
                                    DisplayMember="Name"
                                    SelectedItem="{Binding Category, Mode=TwoWay}"
                                    IsVisible="{Binding CanSelect}"
                                    IsEnabled="{Binding CanSelect}" />

                                <Label
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding RuleNote}"
                                    IsVisible="{Binding HasRuleNote}"
                                    FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>