<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.App.Controls"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    x:Class="ExpenseTracker.App.Views.CategoriesPage"
    x:DataType="vm:CategoriesViewModel"
    Shell.NavBarIsVisible="False"
    Title="Categories"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <controls:CenteredContainer Padding="40,28,40,24">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="20">

            <!-- Title, month, rules, new category -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label
                        Text="{loc:Tr Key='Categories'}"
                        FontSize="28"
                        FontFamily="NunitoExtraBold" />
                    <Label
                        Text="{Binding Subtitle}"
                        FontSize="13"
                        TextColor="{DynamicResource InkMuted}" />
                </VerticalStackLayout>

                <controls:MonthSwitch
                    Grid.Column="1"
                    Title="{Binding MonthTitle}"
                    Month="{Binding Month}"
                    CanGoPrevious="{Binding CanPreviousMonth}"
                    CanGoNext="{Binding CanNextMonth}"
                    PreviousClicked="OnPreviousClicked"
                    NextClicked="OnNextClicked"
                    MonthPicked="OnMonthPicked" />

                <controls:PillButton
                    Grid.Column="2"
                    Text="{loc:Tr Key='Rules'}"
                    Icon="{x:Static controls:Icons.Tag}"
                    Clicked="OnRulesClicked"
                    IsEnabled="{Binding CanEdit}" />

                <controls:PillButton
                    Grid.Column="3"
                    Text="{loc:Tr Key='New category'}"
                    Icon="{x:Static controls:Icons.Plus}"
                    IsPrimary="True"
                    Clicked="OnNewClicked"
                    IsEnabled="{Binding CanEdit}" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding HasSuccess}"
                    TextColor="{DynamicResource Success}" />
            </VerticalStackLayout>

            <!-- Compact list on the left, everything about the chosen category on the right -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="380,*"
                ColumnSpacing="20"
                IsVisible="{Binding ShowResults}">

                <Border Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 0"
                            BackgroundColor="Transparent"
                            Padding="14">
                            <Entry
                                Placeholder="{Binding SearchPlaceholder}"
                                Text="{Binding SearchText, Mode=TwoWay}" />
                        </Border>

                        <BoxView
                            HeightRequest="1"
                            VerticalOptions="End"
                            Color="{DynamicResource Border}" />

                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout Padding="0,0,0,10">
                                <Label
                                    Text="{Binding UsedCaption}"
                                    FontSize="11"
                                    FontFamily="NunitoBold"
                                    CharacterSpacing="0.6"
                                    TextTransform="Uppercase"
                                    TextColor="{DynamicResource InkMuted}"
                                    Margin="22,12,22,6"
                                    IsVisible="{Binding HasUsed}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UsedRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryTile">
                                            <Border
                                                HeightRequest="44"
                                                Margin="6,0"
                                                Padding="16,0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="Transparent">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                                    <PointerGestureRecognizer
                                                        PointerEntered="OnRowPointerEntered"
                                                        PointerExited="OnRowPointerExited" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                                    <BoxView
                                                        WidthRequest="10"
                                                        HeightRequest="10"
                                                        CornerRadius="5"
                                                        VerticalOptions="Center"
                                                        Color="{Binding Color}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        FontFamily="NunitoSemiBold"
                                                        VerticalOptions="Center"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding AmountText}"
                                                        FontSize="13"
                                                        FontFamily="NunitoBold"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label
                                    Text="{Binding UnusedCaption}"
                                    FontSize="11"
                                    FontFamily="NunitoBold"
                                    CharacterSpacing="0.6"
                                    TextTransform="Uppercase"
                                    TextColor="{DynamicResource InkMuted}"
                                    Margin="22,12,22,6"
                                    IsVisible="{Binding HasUnused}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnusedRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryTile">
                                            <Border
                                                HeightRequest="44"
                                                Margin="6,0"
                                                Padding="16,0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="Transparent">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                                    <PointerGestureRecognizer
                                                        PointerEntered="OnRowPointerEntered"
                                                        PointerExited="OnRowPointerExited" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                                    <BoxView
                                                        WidthRequest="10"
                                                        HeightRequest="10"
                                                        CornerRadius="5"
                                                        VerticalOptions="Center"
                                                        Color="{Binding Color}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        FontFamily="NunitoSemiBold"
                                                        TextColor="{DynamicResource InkMuted}"
                                                        VerticalOptions="Center"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding AmountText}"
                                                        FontSize="13"
                                                        FontFamily="NunitoBold"
                                                        TextColor="{DynamicResource InkMuted}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label
                                    Text="{loc:Tr Key='No categories match the search.'}"
                                    Margin="22,16"
                                    TextColor="{DynamicResource InkMuted}"
                                    IsVisible="{Binding NothingFound}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="0">
                    <ScrollView>
                        <VerticalStackLayout Spacing="22" Padding="28,26" IsVisible="{Binding HasSelection}">

                            <!-- Name and actions -->
                            <Grid ColumnDefinitions="56,*,Auto,Auto" ColumnSpacing="16">
                                <Border
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{Binding Selected.Tint}">
                                    <controls:IconView
                                        Data="{x:Static controls:Icons.Tag}"
                                        Color="{Binding Selected.Color}"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Selected.Name}"
                                    FontSize="24"
                                    FontFamily="NunitoExtraBold"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation" />

                                <controls:PillButton
                                    Grid.Column="2"
                                    Text="{loc:Tr Key='Rename'}"
                                    Icon="{x:Static controls:Icons.Edit}"
                                    Clicked="OnRenameClicked"
                                    IsEnabled="{Binding CanEdit}" />

                                <controls:PillButton
                                    Grid.Column="3"
                                    Text="{loc:Tr Key='Show entries'}"
                                    Icon="{x:Static controls:Icons.ChevronRight}"
                                    Clicked="OnShowEntriesClicked" />
                            </Grid>

                            <!-- Numbers of the month -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                <Border Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding MonthTitle}" FontSize="12" FontFamily="NunitoSemiBold" TextColor="{DynamicResource InkMuted}" />
                                        <Label Text="{Binding Selected.AmountText}" FontSize="20" FontFamily="NunitoExtraBold" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{loc:Tr Key='Share of month'}" FontSize="12" FontFamily="NunitoSemiBold" TextColor="{DynamicResource InkMuted}" />
                                        <Label Text="{Binding Selected.ShareText}" FontSize="20" FontFamily="NunitoExtraBold" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{loc:Tr Key='Entries'}" FontSize="12" FontFamily="NunitoSemiBold" TextColor="{DynamicResource InkMuted}" />
                                        <Label Text="{Binding Selected.CountText}" FontSize="20" FontFamily="NunitoExtraBold" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="3" Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{loc:Tr Key='Avg / entry'}" FontSize="12" FontFamily="NunitoSemiBold" TextColor="{DynamicResource InkMuted}" />
                                        <Label Text="{Binding Selected.AverageText}" FontSize="20" FontFamily="NunitoExtraBold" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Color and links -->
                            <Grid ColumnDefinitions="250,*" ColumnSpacing="28">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{loc:Tr Key='Color'}" FontSize="15" FontFamily="NunitoBold" />
                                    <Label
                                        Text="{loc:Tr Key='Pick one of the colors, or mix your own with the last one.'}"
                                        FontSize="12"
                                        TextColor="{DynamicResource InkMuted}"
                                        Margin="0,0,0,10" />

                                    <FlexLayout
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        BindableLayout.ItemsSource="{Binding Swatches}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SwatchItem">
                                                <Border
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    Margin="0,0,10,10"
                                                    StrokeShape="RoundRectangle 16"
                                                    StrokeThickness="0"
                                                    BackgroundColor="Transparent">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="Stroke" Value="{DynamicResource Ink}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Grid>
                                                        <BoxView
                                                            WidthRequest="22"
                                                            HeightRequest="22"
                                                            CornerRadius="11"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            Color="{Binding Color}" />
                                                        <controls:IconView
                                                            Data="{x:Static controls:Icons.Plus}"
                                                            Color="{DynamicResource Ink}"
                                                            WidthRequest="14"
                                                            HeightRequest="14"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding ShowPlus}" />
                                                    </Grid>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnSwatchTapped" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="10">
                                    <Label Text="{loc:Tr Key='Linked'}" FontSize="15" FontFamily="NunitoBold" />

                                    <Border Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:IconView
                                                Data="{x:Static controls:Icons.Wallet}"
                                                Color="{DynamicResource InkMuted}"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{loc:Tr Key='Monthly budget'}" FontFamily="NunitoBold" />
                                                <Label
                                                    Text="{Binding Selected.BudgetText}"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource InkMuted}" />
                                            </VerticalStackLayout>
                                            <controls:PillButton
                                                Grid.Column="2"
                                                Text="{Binding Selected.BudgetButtonText}"
                                                IsCompact="True"
                                                Clicked="OnBudgetClicked" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="16,14" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Bg}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRulesClicked" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:IconView
                                                Data="{x:Static controls:Icons.Tag}"
                                                Color="{DynamicResource InkMuted}"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{loc:Tr Key='Auto-categorization rules'}" FontFamily="NunitoBold" />
                                                <Label
                                                    Text="{Binding Selected.RulesText}"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource InkMuted}" />
                                            </VerticalStackLayout>
                                            <controls:IconView
                                                Grid.Column="2"
                                                Data="{x:Static controls:Icons.ChevronRight}"
                                                Color="{DynamicResource InkMuted}"
                                                WidthRequest="16"
                                                HeightRequest="16"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Danger zone -->
                            <Border
                                Padding="16"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource Danger}"
                                BackgroundColor="Transparent">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <controls:IconView
                                        Data="{x:Static controls:Icons.Trash}"
                                        Color="{DynamicResource Danger}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{loc:Tr Key='Delete category'}" FontFamily="NunitoBold" />
                                        <Label
                                            Text="{loc:Tr Key='Its entries can be moved to a category you choose first.'}"
                                            FontSize="12"
                                            TextColor="{DynamicResource InkMuted}" />
                                    </VerticalStackLayout>
                                    <controls:PillButton
                                        Grid.Column="2"
                                        Text="{loc:Tr Key='Delete…'}"
                                        ToneKey="Danger"
                                        Clicked="OnDeleteClicked"
                                        IsEnabled="{Binding CanEdit}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <Label
                    Grid.Column="1"
                    Text="{loc:Tr Key='No categories yet. Create your first category above.'}"
                    Margin="24"
                    TextColor="{DynamicResource InkMuted}"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Start"
                    IsVisible="{Binding IsEmpty}" />
            </Grid>
        </Grid>
    </controls:CenteredContainer>
</ContentPage>
