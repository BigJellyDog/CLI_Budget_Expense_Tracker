<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.CategoriesPage"
    x:DataType="vm:CategoriesViewModel"
    Shell.NavBarIsVisible="False"
    Title="Categories"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Label
                Text="{loc:Tr Key='Categories'}"
                FontSize="26"
                FontFamily="ManropeExtraBold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="{loc:Tr Key='Auto-categorization rules'}"
                Clicked="OnRulesClicked"
                IsEnabled="{Binding CanRefresh}" />

            <Button
                Grid.Column="2"
                Text="{loc:Tr Key='Refresh'}"
                Clicked="OnRefreshClicked"
                IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8"
            IsEnabled="{Binding CanEdit}">

            <Label
                Text="{Binding FormTitle}"
                FontAttributes="Bold" />

            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="12">

                <Entry
                    x:Name="CategoryNameEntry"
                    Placeholder="{loc:Tr Key='Category name'}"
                    Text="{Binding NameText, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnSaveClicked" />

                <Button
                    Grid.Column="2"
                    Text="{loc:Tr Key='Cancel'}"
                    Clicked="OnCancelClicked"
                    IsVisible="{Binding IsEditing}" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{DynamicResource Danger}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding HasSuccess}"
                TextColor="{DynamicResource Success}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding ShowResults}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="{loc:Tr Key='No categories yet. Create your first category above.'}"
                    Margin="24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:Category">
                    <Border
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 18"
                        Stroke="{DynamicResource Border}"
                        BackgroundColor="{DynamicResource Surface}">
                        
                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="12">

                            <Label
                                Text="{Binding Name}"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />

                            <Button
                                Grid.Column="1"
                                Text="{loc:Tr Key='Rename'}"
                                Clicked="OnRenameClicked" />

                            <Button
                                Grid.Column="2"
                                Text="{loc:Tr Key='Delete'}"
                                Clicked="OnDeleteClicked"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>