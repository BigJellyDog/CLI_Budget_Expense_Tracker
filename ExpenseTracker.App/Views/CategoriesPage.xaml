<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.CategoriesPage"
    x:DataType="vm:CategoriesViewModel"
    Title="Categories"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#151821}">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label
                Text="Categories"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="Refresh"
                Clicked="OnRefreshClicked"
                IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8"
            IsEnabled="{Binding CanEdit}">

            <Label
                Text="{Binding FormTitle}"
                FontAttributes="Bold" />

            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="12">

                <Entry
                    x:Name="CategoryNameEntry"
                    Placeholder="Category name"
                    Text="{Binding NameText, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Clicked="OnSaveClicked" />

                <Button
                    Grid.Column="2"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    IsVisible="{Binding IsEditing}" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding HasSuccess}"
                TextColor="{AppThemeBinding Light=#18794E, Dark=#75D6A6}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding ShowResults}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No categories yet. Create your first category above."
                    Margin="24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:Category">
                    <Border
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light=#D8DDE8, Dark=#384054}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#202532}">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <Label
                                Text="{Binding Name}"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />

                            <Button
                                Grid.Column="1"
                                Text="Rename"
                                Clicked="OnRenameClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>