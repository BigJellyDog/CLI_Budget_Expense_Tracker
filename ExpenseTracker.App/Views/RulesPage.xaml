<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.App.Controls"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.RulesPage"
    x:DataType="vm:RulesViewModel"
    Title="Auto-categorization rules"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label
                Text="{loc:Tr Key='Auto-categorization rules'}"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="{loc:Tr Key='Refresh'}"
                Clicked="OnRefreshClicked"
                IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8"
            IsEnabled="{Binding CanEdit}">

            <Label
                Text="{loc:Tr Key='When the description of a bank record contains the text, the CSV import preview puts it into the chosen category. Upper and lower case do not matter. If several rules fit, the longest text wins.'}"
                FontSize="12" />

            <Label
                Text="{loc:Tr Key='Create a category on the Categories screen first.'}"
                IsVisible="{Binding ShowNoCategories}" />

            <Grid
                ColumnDefinitions="*,*,Auto"
                ColumnSpacing="12">

                <Entry
                    Placeholder="{loc:Tr Key='Contains, e.g. LIDL'}"
                    Text="{Binding PatternText, Mode=TwoWay}" />

                <controls:DropDown
                    Grid.Column="1"
                    Title="{loc:Tr Key='Category'}"
                    ItemsSource="{Binding Categories}"
                    DisplayMember="Name"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <Button
                    Grid.Column="2"
                    Text="{loc:Tr Key='Add rule'}"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnAddClicked" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{DynamicResource Danger}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding HasSuccess}"
                TextColor="{DynamicResource Success}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding ShowResults}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="{loc:Tr Key='No rules yet. Add your first rule above.'}"
                    Margin="24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RuleListItem">
                    <Border
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 18"
                        Stroke="{DynamicResource Border}"
                        BackgroundColor="{DynamicResource Surface}">

                        <Grid
                            ColumnDefinitions="*,*,Auto"
                            ColumnSpacing="12">

                            <Label
                                Text="{Binding Pattern, StringFormat='contains &quot;{0}&quot;'}"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding CategoryName, StringFormat='→ {0}'}"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />

                            <Button
                                Grid.Column="2"
                                Text="{loc:Tr Key='Delete'}"
                                Clicked="OnDeleteClicked"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
