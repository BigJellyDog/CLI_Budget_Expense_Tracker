<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.App.Controls"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    x:Class="ExpenseTracker.App.Views.SettingsPage"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="Settings"
    BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="640"
            HorizontalOptions="Start">

            <Label
                Text="{loc:Tr Key='Settings'}"
                FontSize="26"
                FontFamily="NunitoExtraBold" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr Key='Language'}" FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='The language of the screens. The app reloads its screens when you change it.'}"
                    TextColor="{DynamicResource InkMuted}"
                    FontSize="12" />

                <controls:DropDown
                    x:Name="LanguagePicker"
                    WidthRequest="240"
                    HorizontalOptions="Start"
                    Title="{loc:Tr Key='Language'}"
                    ItemsSource="{Binding LanguageOptions}"
                    DisplayMember="Name"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                    SelectedIndexChanged="OnLanguageChanged" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr Key='Appearance'}" FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='Mode follows the system theme, or stays light or dark. The accent sets the color of buttons and the selected menu item. Changes apply at once.'}"
                    TextColor="{DynamicResource InkMuted}"
                    FontSize="12" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <controls:DropDown
                        x:Name="ModePicker"
                        Title="{loc:Tr Key='Mode'}"
                        ItemsSource="{Binding ModeOptions}"
                        Translate="True"
                        SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                        SelectedIndexChanged="OnAppearanceChanged" />

                    <controls:DropDown
                        x:Name="AccentPicker"
                        Grid.Column="1"
                        Title="{loc:Tr Key='Accent'}"
                        ItemsSource="{Binding AccentOptions}"
                        Translate="True"
                        SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                        SelectedIndexChanged="OnAppearanceChanged" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr Key='Currency'}" FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='Three-letter code shown next to amounts, for example EUR, USD or CHF. Changing it does not convert amounts that are already saved.'}"
                    FontSize="12" />

                <Grid ColumnDefinitions="140,Auto" ColumnSpacing="12">
                    <Entry
                        Placeholder="EUR"
                        MaxLength="3"
                        Text="{Binding CurrencyText, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Text="{loc:Tr Key='Save'}"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked" />
                </Grid>

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding HasSuccess}"
                    TextColor="{DynamicResource Success}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr Key='Demo data'}" FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='Fills the app with a year of sample data, counted back from today, so every screen has something to show.'}"
                    TextColor="{DynamicResource InkMuted}"
                    FontSize="12" />

                <controls:PillButton
                    Text="{loc:Tr Key='Load demo data'}"
                    HorizontalOptions="Start"
                    Clicked="OnLoadDemoClicked"
                    IsEnabled="{Binding CanLoadDemo}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr Key='Where your data is'}" FontAttributes="Bold" />

                <Label
                    Text="{loc:Tr Key='The database, backups, exports, logs and these settings are in one folder:'}"
                    FontSize="12" />

                <Label
                    Text="{Binding DataFolder}"
                    LineBreakMode="MiddleTruncation" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
