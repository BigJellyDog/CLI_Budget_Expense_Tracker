<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    x:Class="ExpenseTracker.App.Views.SettingsPage"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="Settings"
    BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            MaximumWidthRequest="640"
            HorizontalOptions="Start">

            <Label
                Text="Settings"
                FontSize="26"
                FontFamily="ManropeExtraBold" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Appearance" FontAttributes="Bold" />

                <Label
                    Text="Mode follows the system theme, or stays light or dark. The accent sets the color of buttons and the selected menu item. Changes apply at once."
                    TextColor="{DynamicResource InkMuted}"
                    FontSize="12" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Picker
                        x:Name="ModePicker"
                        Title="Mode"
                        ItemsSource="{Binding ModeOptions}"
                        SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                        SelectedIndexChanged="OnAppearanceChanged" />

                    <Picker
                        x:Name="AccentPicker"
                        Grid.Column="1"
                        Title="Accent"
                        ItemsSource="{Binding AccentOptions}"
                        SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                        SelectedIndexChanged="OnAppearanceChanged" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Currency" FontAttributes="Bold" />

                <Label
                    Text="Three-letter code shown next to amounts, for example EUR, USD or CHF. Changing it does not convert amounts that are already saved."
                    FontSize="12" />

                <Grid ColumnDefinitions="140,Auto" ColumnSpacing="12">
                    <Entry
                        Placeholder="EUR"
                        MaxLength="3"
                        Text="{Binding CurrencyText, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Text="Save"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked" />
                </Grid>

                <Label
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    TextColor="{DynamicResource Danger}" />

                <Label
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding HasSuccess}"
                    TextColor="{DynamicResource Success}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Where your data is" FontAttributes="Bold" />

                <Label
                    Text="The database, backups, exports, logs and these settings are in one folder:"
                    FontSize="12" />

                <Label
                    Text="{Binding DataFolder}"
                    LineBreakMode="MiddleTruncation" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
