<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:ExpenseTracker.App.Services"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    xmlns:core="clr-namespace:CLI_Budget_Expense_Tracker.Core.Models;assembly=CLI_Budget_Expense_Tracker.Core"
    x:Class="ExpenseTracker.App.Views.RecurringExpensesPage"
    x:DataType="vm:RecurringExpensesViewModel"
    Shell.NavBarIsVisible="False"
    Title="Recurring expenses"
    NavigationPage.HasBackButton="{Binding CanGoBack}"
    BackgroundColor="{DynamicResource Bg}">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <Grid
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12">

            <Label
                Text="{loc:Tr Key='Recurring expenses'}"
                FontSize="26"
                FontFamily="ManropeExtraBold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="{loc:Tr Key='Refresh'}"
                Clicked="OnRefreshClicked"
                IsEnabled="{Binding CanRefresh}" />

            <Button
                Grid.Column="2"
                Text="{loc:Tr Key='Generate due expenses'}"
                Clicked="OnGenerateClicked"
                IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{DynamicResource Danger}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding HasSuccess}"
                TextColor="{DynamicResource Success}" />

            <Label
                Text="{loc:Tr Key='Create a category on the Categories screen first.'}"
                IsVisible="{Binding ShowNoCategories}" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="360,*"
            ColumnSpacing="24">

            <ScrollView>
                <VerticalStackLayout Spacing="16">
                    <Label
                        Text="{Binding FormTitle}"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <VerticalStackLayout
                        Spacing="10"
                        IsEnabled="{Binding CanEdit}">

                        <Label Text="{loc:Tr Key='Category'}" />

                        <Picker
                            Title="{loc:Tr Key='Choose a category'}"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name, x:DataType=core:Category}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                        <Label Text="{loc:Tr Key='Amount per occurrence'}" />

                        <Entry
                            Placeholder="12.50"
                            Keyboard="Numeric"
                            Text="{Binding AmountText, Mode=TwoWay}" />

                        <Label Text="{loc:Tr Key='Frequency'}" />

                        <Picker
                            Title="{loc:Tr Key='Choose a frequency'}"
                            ItemsSource="{Binding Frequencies}"
                            ItemDisplayBinding="{Binding ., x:DataType=sys:Object, Converter={x:Static loc:TrConverter.Instance}}"
                            SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}" />

                        <Label Text="{loc:Tr Key='Start date'}" />

                        <DatePicker
                            Date="{Binding SelectedStartDate, Mode=TwoWay}"
                            MinimumDate="{x:Null}"
                            MaximumDate="{x:Null}"
                            IsEnabled="{Binding CanChangeStartDate}"
                            Format="dd.MM.yyyy" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasEndDate, Mode=TwoWay}" />
                            <Label
                                Text="{loc:Tr Key='End date (optional)'}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <DatePicker
                            Date="{Binding SelectedEndDate, Mode=TwoWay}"
                            MinimumDate="{x:Null}"
                            MaximumDate="{x:Null}"
                            IsEnabled="{Binding HasEndDate}"
                            Format="dd.MM.yyyy" />

                        <Label Text="{loc:Tr Key='Description (optional)'}" />

                        <Editor
                            Text="{Binding Description, Mode=TwoWay}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80" />

                        <Label
                            Text="{loc:Tr Key='Creating a schedule also generates due expenses through today. Past start dates include missed occurrences.'}"
                            FontSize="12"
                            IsVisible="{Binding CanChangeStartDate}" />

                        <Label
                            Text="{loc:Tr Key='Changes apply to future expenses only. Expenses created earlier are not changed. A new frequency counts from the next due date.'}"
                            FontSize="12"
                            IsVisible="{Binding IsEditing}" />

                        <Button
                            Text="{Binding SaveButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSaveClicked" />

                        <Button
                            Text="{loc:Tr Key='Cancel'}"
                            Clicked="OnCancelEditClicked"
                            IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>

                    <Button
                        Text="{loc:Tr Key='Add another schedule'}"
                        Clicked="OnAddAnotherClicked"
                        IsVisible="{Binding IsSaved}"
                        IsEnabled="{Binding CanStartNew}" />
                </VerticalStackLayout>
            </ScrollView>

            <CollectionView
                Grid.Column="1"
                ItemsSource="{Binding Items}"
                IsVisible="{Binding ShowResults}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="{loc:Tr Key='No recurring expenses yet.'}"
                        Margin="24"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecurringExpenseListItem">
                        <Border
                            Padding="16"
                            Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 18"
                            Stroke="{DynamicResource Border}"
                            BackgroundColor="{DynamicResource Surface}">

                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label
                                        Text="{Binding CategoryName}"
                                        FontSize="16"
                                        FontFamily="ManropeExtraBold" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Summary}"
                                        FontFamily="ManropeBold" />
                                </Grid>

                                <Label
                                    Text="{Binding Description}"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding StartText}"
                                    TextColor="{DynamicResource InkMuted}"
                                    FontSize="12" />

                                <Label
                                    Text="{Binding NextDueText}"
                                    TextColor="{DynamicResource InkMuted}"
                                    FontSize="12" />

                                <Label
                                    Text="{Binding EndText}"
                                    IsVisible="{Binding HasEndDate}"
                                    TextColor="{DynamicResource InkMuted}"
                                    FontSize="12" />

                                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                    <Button
                                        Text="{loc:Tr Key='Edit'}"
                                        Clicked="OnEditClicked" />

                                    <Button
                                        Text="{loc:Tr Key='Deactivate'}"
                                        Clicked="OnDeactivateClicked"
                                        IsVisible="{Binding IsActive}"
                                        Style="{StaticResource DangerButton}" />

                                    <Button
                                        Text="{loc:Tr Key='Reactivate'}"
                                        Clicked="OnReactivateClicked"
                                        IsVisible="{Binding IsInactive}" />

                                    <Button
                                        Text="{loc:Tr Key='Delete'}"
                                        Clicked="OnDeleteClicked"
                                        IsVisible="{Binding IsInactive}"
                                        Style="{StaticResource DangerButton}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>