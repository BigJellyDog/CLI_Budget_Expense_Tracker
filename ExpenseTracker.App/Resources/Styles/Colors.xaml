<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        StyleLavender tokens. These are the defaults (Lavender, dark); ThemeService replaces
        the values at run time when the user picks another mode or accent in Settings.
        Every page and style refers to them with DynamicResource.
    -->

    <Color x:Key="Bg">#15131c</Color>
    <Color x:Key="Surface">#1e1b28</Color>
    <Color x:Key="Surface2">#2a2638</Color>
    <Color x:Key="Border">#3a3550</Color>
    <Color x:Key="Ink">#f1eefa</Color>
    <Color x:Key="InkMuted">#aba5bf</Color>
    <Color x:Key="Accent">#b4a0f5</Color>
    <Color x:Key="OnAccent">#1a1330</Color>
    <Color x:Key="AccentSoft">#352d55</Color>
    <Color x:Key="Danger">#ff9b92</Color>
    <Color x:Key="Success">#86e3b0</Color>
    <Color x:Key="Warning">#f5c76b</Color>
    <Color x:Key="Track">#2f2a40</Color>

    <Color x:Key="CatFood">#f5b77a</Color>
    <Color x:Key="CatFun">#c9b6ff</Color>
    <Color x:Key="CatPets">#7fd8e8</Color>
    <Color x:Key="CatHealth">#ff9fb6</Color>
    <Color x:Key="CatMove">#9fc0ff</Color>
    <Color x:Key="CatShop">#b5e06b</Color>
</ResourceDictionary>
