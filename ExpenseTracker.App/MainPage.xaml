<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ExpenseTracker.App.ViewModels"
    xmlns:models="clr-namespace:ExpenseTracker.App.Models"
    x:Class="ExpenseTracker.App.MainPage"
    x:DataType="vm:ExpensesViewModel"
    Title="Expenses"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#151821}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Add expense"
            Clicked="OnAddExpenseClicked" />

        <ToolbarItem
            Text="Add CSV"
            Clicked="OnBankImportClicked" />
        <ToolbarItem
            Text="Categories"
            Clicked="OnCategoriesClicked" />
        <ToolbarItem
            Text="Budgets"
            Clicked="OnBudgetsClicked" />
        <ToolbarItem
            Text="Recurring expenses"
            Clicked="OnRecurringExpensesClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="12">

            <Button
                Text="Previous"
                Command="{Binding PreviousMonthCommand}" />

            <Label
                Grid.Column="1"
                Text="{Binding MonthTitle}"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <Button
                Grid.Column="2"
                Text="Next"
                Command="{Binding NextMonthCommand}" />

            <Button
                Grid.Column="3"
                Text="Refresh"
                Command="{Binding RefreshCommand}" />
        </Grid>

        <Label
            Grid.Row="1"
            Text="{Binding Summary}"
            FontSize="18"
            IsVisible="{Binding ShowResults}" />

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding ShowResults}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No expenses for this month."
                    Margin="24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExpenseListItem">
                    <Border
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light=#D8DDE8, Dark=#384054}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#202532}">

                        <Grid
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="16"
                            RowSpacing="6">

                            <Label
                                Text="{Binding CategoryName}"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Amount, StringFormat='{0:N2}'}"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Description}"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                                HorizontalTextAlignment="End" />

                            <Button
                                Grid.Column="2"
                                Grid.RowSpan="2"
                                Text="Edit"
                                Clicked="OnEditExpenseClicked"
                                VerticalOptions="Center"
                                Padding="12,6" />
                            
                            <Button
                                Grid.Column="3"
                                Grid.RowSpan="2"
                                Text="Delete"
                                Clicked="OnDeleteExpenseClicked"
                                VerticalOptions="Center"
                                Padding="12,6"
                                BackgroundColor="{AppThemeBinding Light=#B42318, Dark=#A32A25}"
                                TextColor="White" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>