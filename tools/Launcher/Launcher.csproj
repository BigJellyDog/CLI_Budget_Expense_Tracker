<Project Sdk="Microsoft.NET.Sdk">

	<!-- A tiny native starter for the release zip: it is the only exe in the zip's root and starts
	     app\ExpenseTracker.App.exe, so all the other files can live in subfolders. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>ExpenseTracker</AssemblyName>
		<RootNamespace>ExpenseTracker.Launcher</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<AssemblyTitle>Expense Tracker</AssemblyTitle>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<DebugType>none</DebugType>
	</PropertyGroup>

</Project>
